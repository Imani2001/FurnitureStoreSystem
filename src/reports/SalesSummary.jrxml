	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="FurnitureStore"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<queryString>
		<![CDATA[SELECT 
    so.OrderID,
    so.OrderDate,
    CONCAT(c.FirstName, ' ', c.LastName) AS CustomerName,
    c.City,
    so.TotalAmount,
    so.Status
FROM SalesOrder so
JOIN Customer c ON so.CustomerID = c.CustomerID
ORDER BY so.OrderDate DESC]]>
	</queryString>
