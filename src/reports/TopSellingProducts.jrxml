<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TopSellingProducts" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="34ec2d2c-e98d-4c57-9c3c-7a9054378cde">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="FurnitureStore"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<queryString>
		<![CDATA[SELECT 
    p.ProductName,
    c.CategoryName,
    SUM(od.Quantity) AS TotalSold,
    SUM(od.Subtotal) AS TotalRevenue
FROM OrderDetail od
JOIN Product p ON od.ProductID = p.ProductID
JOIN Category c ON p.CategoryID = c.CategoryID
GROUP BY p.ProductID, p.ProductName, c.CategoryName
ORDER BY TotalSold DESC]]>
	</queryString>
	<field name="ProductName" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="ProductName"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="product"/>
	</field>
	<field name="CategoryName" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CategoryName"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="category"/>
	</field>
	<field name="TotalSold" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="TotalSold"/>
	</field>
	<field name="TotalRevenue" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="TotalRevenue"/>
	</field>
