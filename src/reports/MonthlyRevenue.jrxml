	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="FurnitureStore"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<queryString>
		<![CDATA[SELECT 
    DATE_FORMAT(so.OrderDate, '%Y-%m') AS Month,
    COUNT(so.OrderID) AS OrderCount,
    SUM(so.TotalAmount) AS TotalRevenue,
    AVG(so.TotalAmount) AS AvgOrderValue
FROM SalesOrder so
WHERE so.Status = 'Completed'
GROUP BY DATE_FORMAT(so.OrderDate, '%Y-%m')
ORDER BY Month DESC]]>
	</queryString>
	<field name="Month" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="Month"/>
	</field>
	<field name="OrderCount" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.label" value="OrderCount"/>
	</field>
	<field name="TotalRevenue" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="TotalRevenue"/>
	</field>
	<field name="AvgOrderValue" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="AvgOrderValue"/>
	</field>
